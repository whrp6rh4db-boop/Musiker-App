/* V2.3.0: beginner-friendly saxophone with instrument silhouette and clear finger cards */
.sax-illustration{max-width:560px;margin:auto;background:radial-gradient(ellipse at 50% 45%,#254364,#0d1c31 72%);border-radius:20px;overflow:hidden;border:1px solid #355777}.sax-real{display:block;width:100%;height:auto}.sax-real [data-sax-key]{cursor:pointer}.sax-finger-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:15px 0}.sax-finger-panel{background:#172f4a;border:1px solid #5287c1;border-radius:16px;padding:12px}.sax-finger-panel.right{background:#30271f;border-color:#d28b53}.sax-finger-panel h4{margin:0 0 10px;color:#8dc5ff}.sax-finger-panel.right h4{color:#ffbc85}.sax-finger-row{display:grid;grid-template-columns:27px 1fr;gap:5px 8px;padding:7px 0;border-top:1px solid #ffffff1c;font-size:13px}.sax-finger-row b{border-radius:50%;background:#70b6ff;color:#12243b;width:25px;height:25px;text-align:center}.right .sax-finger-row b{background:#ffb16b}.sax-finger-row strong{grid-column:2;color:#b5c4d5;font-size:12px}.sax-finger-row strong.is-down{color:#43dfcb}.sax-extras{background:#122a3c;padding:12px;border-radius:12px;font-size:14px;margin-bottom:12px}@media(max-width:420px){.sax-finger-panels{grid-template-columns:1fr}.sax-finger-row{grid-template-columns:30px 1fr auto}.sax-finger-row strong{grid-column:auto}}

/* V2.3.0 - photographic three-note study cards */
.sax-study{border:1px solid #2e6687;border-radius:20px;padding:14px;background:linear-gradient(140deg,#07182b,#102d45);margin:14px 0;color:#ecf7ff}
.sax-study-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.sax-study-head strong{font-size:clamp(25px,6vw,40px);color:#49e4d2}
.sax-study-controls{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0}
.sax-study-controls button{border:1px solid #4c738c;border-radius:12px;background:#18354c;color:#f3fbff;padding:10px 16px;min-width:64px;font-weight:700;cursor:pointer}
.sax-study-controls button.active{background:#43dfcd;color:#072b37;border-color:#43dfcd}
.sax-study-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;align-items:start}
.sax-study-photo{position:relative;overflow:hidden;border-radius:14px;border:1px solid #3d7189;background:#071323;min-height:420px;display:flex;align-items:center;justify-content:center}
.sax-study-photo img{width:100%;height:460px;object-fit:cover;object-position:center;display:block}
.sax-study-photo .photo-note{position:absolute;bottom:0;left:0;right:0;padding:9px;background:#071525e8;font-size:11px;color:#d6e6f2}
.sax-study-hand{border:1px solid #4e9edb;border-radius:13px;padding:12px;background:#112e49;margin-bottom:10px}
.sax-study-hand.right{border-color:#f09c58;background:#31251e}
.sax-study-hand h4{margin:0 0 10px;color:#8bc5ff}
.sax-study-hand.right h4{color:#ffb576}
.sax-study-finger{display:flex;align-items:center;gap:9px;padding:7px 0;border-top:1px solid #ffffff1c;font-size:13px}
.sax-study-finger b{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;flex-shrink:0;background:#71b5f2;color:#10243a}
.sax-study-hand.right .sax-study-finger b{background:#ffa85e}
.sax-study-finger.on b{background:#37dcca}
.sax-study-finger span{flex:1}
.sax-study-finger em{font-style:normal;color:#b9d4e3}
.sax-study-finger.on em{color:#4be5d3;font-weight:700}
.sax-study-summary{padding:12px;border:1px solid #3a918e;border-radius:13px;background:#0c3340;font-size:14px;line-height:1.6}
.sax-study-summary strong{color:#5ce4d2}
.sax-study-note{font-size:12px;color:#b9cddd;margin:10px 0 0}
@media(max-width:560px){.sax-study-grid{grid-template-columns:1fr}.sax-study-photo{min-height:320px}.sax-study-photo img{height:400px;object-fit:contain}.sax-study-hand{margin-bottom:8px}}

/* V2.3.0: mobile-first saxophone study */
.s216{padding:12px;margin:14px 0;overflow:hidden}
.s216-top{display:grid;grid-template-columns:minmax(95px,1fr) minmax(0,1.5fr);align-items:center;gap:8px}
.s216-top small{font-size:10px;letter-spacing:.08em;color:#a7cce3}
.s216-tone{font-size:clamp(36px,9vw,56px);font-weight:850;color:#50dfce;line-height:1.2}
.s216-top span{font-size:12px;color:#b8cadb}
.s216-staff-wrap{min-width:0;background:#0b2137;border:1px solid #2f607a;border-radius:12px;padding:3px}
.s216-staff{display:block;width:100%;height:auto}
.s216 .sax-study-controls{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.s216 .sax-study-controls button{min-width:0;font-size:17px;padding:13px 5px}
.s216-photo{width:100%;max-width:450px;margin:8px auto 16px;border-radius:15px;border:1px solid #356987;background:#061629;overflow:hidden}
.s216-photo img{display:block;width:100%;height:auto;object-fit:contain}
.s216-photo p{font-size:11px;color:#c2d4e4;line-height:1.5;padding:10px 12px;margin:0;background:#0b2235}
.s216-main{border-radius:15px;background:#10283c;border:1px solid #3b6981;padding:12px}
.s216-main h3{margin:0 0 12px;font-size:19px}
.s216-keys{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.s216-key-col{padding:10px 8px;border-radius:12px;background:#122c46;border:1px solid #4e98d0}
.s216-key-col.orange{background:#35261f;border-color:#d48a51}
.s216-key-col>b{display:block;font-size:12px;letter-spacing:.08em;color:#86baff;text-align:center;margin-bottom:10px}
.s216-key-col.orange>b{color:#ffb477}
.s216-key-row{display:flex;align-items:center;gap:8px;margin:9px 0}
.s216-key-row>span{display:grid;place-items:center;border-radius:50%;width:25px;height:25px;flex:none;background:#60a5fa;color:#061d30;font-weight:800}
.orange .s216-key-row>span{background:#ffac67}
.s216-key-row i{width:35px;height:35px;border-radius:50%;border:3px solid #c2d7e5;background:#d9e4eb;flex:none;box-shadow:inset 0 0 0 2px #7189a3}
.s216-key-row i.pressed{background:#37dcc8;border-color:#e5fff9;box-shadow:0 0 12px #37dcc866}
.s216-key-row small{font-size:11px;color:#d5e8f5}
.s216-hands{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.s216-hand{border-radius:12px;padding:9px 7px;background:#142e49;border:1px solid #468dc8;min-width:0}
.s216-hand.s216-right{background:#35271f;border-color:#c27b47}
.s216-hand h4{font-size:13px;margin:2px 0 10px}
.s216-finger{display:grid;grid-template-columns:24px minmax(0,1fr);align-items:center;column-gap:6px;padding:7px 0;border-top:1px solid #ffffff20}
.s216-num{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#62abef;color:#062138;font-weight:800}
.s216-right .s216-num{background:#ffaf6c}
.s216-name{font-size:11px;overflow-wrap:anywhere}
.s216-finger strong{grid-column:2;font-size:11px;color:#b9c6d1}
.s216-finger.is-down strong{color:#4de2d1}
.s216-result{margin-top:12px;border:1px solid #397c85;background:#10323e;border-radius:14px;padding:14px;line-height:1.55}
.s216-result strong{font-size:18px}
.s216-result p{font-size:14px;margin:9px 0}
.s216-result .s216-hint{font-size:12px;color:#b5cfdb}
