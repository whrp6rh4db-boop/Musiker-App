$('circleSvg').addEventListener('pointermove',circleMove);
$('circleSvg').addEventListener('pointerup',circleEnd);
$('circleSvg').addEventListener('pointercancel',circleEnd);

// V2.3.0: Instrument-first chord detection. All touches act directly on SVG keys/strings.
let rfInstrument='piano',rfPiano=new Set([60,64,67]),rfFrets=[0,0,0,0,0,0];
const rfOpen=[40,45,50,55,59,64];
const rfShapes=[['',[0,4,7]],['m',[0,3,7]],['7',[0,4,7,10]],['maj7',[0,4,7,11]],['m7',[0,3,7,10]],['sus2',[0,2,7]],['sus4',[0,5,7]],['dim',[0,3,6]],['aug',[0,4,8]],['6',[0,4,7,9]],['m6',[0,3,7,9]],['m7b5',[0,3,6,10]],['add9',[0,2,4,7]],['7sus4',[0,5,7,10]],['dim7',[0,3,6,9]]];
function rfName(m){return chrom[((m%12)+12)%12]}
function rfSvgPiano(){
 let z='<div class="reverse-board reverse-piano"><svg viewBox="0 0 720 225" role="group" aria-label="Spielbare Klaviatur von C4 bis H5">';
 const white=[0,2,4,5,7,9,11];
 for(let i=0;i<14;i++){let m=60+12*Math.floor(i/7)+white[i%7],x=i*51+2;z+=`<rect data-rf="${m}" tabindex="0" role="button" aria-label="Taste ${rfName(m)} ${Math.floor(m/12)-1}" x="${x}" y="4" width="49" height="212" rx="4" stroke="#586a78" stroke-width="1.5" fill="${rfPiano.has(m)?'#50dfce':'#f8fafc'}"/><text x="${x+24}" y="202" fill="#243447" font-size="12" text-anchor="middle" pointer-events="none">${rfName(m)}</text>`}
 for(let oct=0;oct<2;oct++)for(let j of [0,1,3,4,5]){let m=60+12*oct+white[j]+1,x=(oct*7+j+1)*51-16;z+=`<rect data-rf="${m}" tabindex="0" role="button" aria-label="Taste ${rfName(m)} ${Math.floor(m/12)-1}" x="${x}" y="4" width="32" height="132" rx="4" fill="${rfPiano.has(m)?'#50dfce':'#172132'}" stroke="#091321" stroke-width="2"/>`}
 return z+'</svg></div><div class="reverse-legend">Türkis = ausgewählt · Tippe erneut zum Abwählen · 2 Oktaven einschließlich schwarzer Tasten</div>';
}
function rfSvgGuitar(){
 let z='<div class="reverse-board"><svg viewBox="0 0 850 310" role="group" aria-label="Spielbares Gitarrengriffbrett mit zwölf Bünden">';
 z+='<rect x="58" y="27" width="778" height="237" rx="9" fill="#6d4c34"/>';
 for(let f=0;f<=12;f++){let x=100+f*59;z+=`<line x1="${x}" x2="${x}" y1="27" y2="264" stroke="${f===0?'#f4e6c6':'#c5c5c5'}" stroke-width="${f===0?7:3}"/>`}
 for(let f of [3,5,7,9,12]){let x=100+(f-.5)*59;if(f===12){for(let y of [102,191])z+=`<circle cx="${x}" cy="${y}" r="9" fill="#f0d8aa" opacity=".85"/>`}else z+=`<circle cx="${x}" cy="145" r="10" fill="#f0d8aa" opacity=".85"/>`}
 for(let i=0;i<6;i++){let y=45+i*40;z+=`<line x1="58" y1="${y}" x2="836" y2="${y}" stroke="#d6d4cc" stroke-width="${3.5-i*.35}"/><text x="18" y="${y+5}" fill="#ffffff" font-size="15" text-anchor="middle">${['E','A','D','G','H','e'][i]}</text>`;
 z+=`<rect data-rf="${i}:x" role="button" tabindex="0" aria-label="Saite ${i+1} stummschalten" x="28" y="${y-16}" width="26" height="32" fill="transparent"/><text x="41" y="${y+5}" fill="${rfFrets[i]<0?'#ffb3a8':'#a7b5c6'}" font-size="18" text-anchor="middle" pointer-events="none">${rfFrets[i]<0?'×':'·'}</text>`;for(let f=0;f<=12;f++){let x=f===0?78:100+(f-.5)*59;z+=`<rect data-rf="${i}:${f}" role="button" tabindex="0" aria-label="Saite ${i+1} Bund ${f}" x="${x-23}" y="${y-17}" width="46" height="34" rx="4" fill="transparent"/>`}
 let f=rfFrets[i];if(f>=0){let x=f===0?78:100+(f-.5)*59;z+=`<circle cx="${x}" cy="${y}" r="13" fill="#50dfce" stroke="#123e43" stroke-width="2" pointer-events="none"/><text x="${x}" y="${y+5}" font-size="12" text-anchor="middle" fill="#092e34" font-weight="bold" pointer-events="none">${f===0?'O':f}</text>`}
 }
 for(let f=1;f<=12;f++)z+=`<text x="${100+(f-.5)*59}" y="288" font-size="13" fill="#ffffff" text-anchor="middle">${f}</text>`;
 return z+'</svg></div><div class="reverse-legend">Tippe direkt auf Saite und Bund (0 = offen). Tippe links auf ×, um eine Saite stummzuschalten. 0 = Leersaite. Positionspunkte: 3 · 5 · 7 · 9 · 12.</div>';
}
function rfUpdate(){
 const notes=rfInstrument==='piano'?[...rfPiano]:rfFrets.flatMap((f,i)=>f<0?[]:[rfOpen[i]+f]);
 const pc=[...new Set(notes.map(n=>(n%12+12)%12))].sort((a,b)=>a-b);
 let matches=[];
 for(let root=0;root<12;root++)for(let [suffix,steps] of rfShapes)if(steps.length===pc.length&&steps.every(x=>pc.includes((root+x)%12)))matches.push(rfName(root)+suffix);
 const bass=notes.length?rfName(Math.min(...notes)):null;
 // Vorschläge: Ein Akkord darf fehlende Töne haben, aber keine fremden Töne.
 const suggestions=[];
 if(!matches.length && pc.length>=2)for(let root=0;root<12;root++)for(let [suffix,steps] of rfShapes){
   const expected=steps.map(x=>(root+x)%12);
   if(pc.every(n=>expected.includes(n)) && pc.length<expected.length && expected.length-pc.length<=2){
     const missing=expected.filter(n=>!pc.includes(n));
     suggestions.push({name:rfName(root)+suffix,missing,score:missing.length+(suffix==='add9'?0.3:0)});
   }
 }
 suggestions.sort((a,b)=>a.score-b.score || a.name.length-b.name.length);
 $('reverseName').textContent=!notes.length?'Keine Töne':matches.length?matches.slice(0,4).join(' / '):suggestions.length?'Mögliche Akkorde: '+suggestions.slice(0,3).map(x=>x.name).join(' / '):pc.length<3?'Weitere Töne auswählen':'Kein eindeutiger Standardakkord';
 $('reverseNotes').textContent='Töne: '+(pc.length?pc.map(rfName).join(' · '):'–');
 $('reverseHint').textContent=(bass?'Basston: '+bass+'. ':'')+(suggestions.length&&!matches.length?'Für '+suggestions[0].name+' fehlt noch: '+suggestions[0].missing.map(rfName).join(', ')+'. ':'')+(matches.length?'Die Vorschläge berücksichtigen alle klingenden Saiten.':'');
 $('reverseInstrument').innerHTML=rfInstrument==='piano'?rfSvgPiano():rfSvgGuitar();
}
$('reversePiano').onclick=()=>{rfInstrument='piano';$('reversePiano').classList.add('active');$('reverseGuitar').classList.remove('active');rfUpdate()};
$('reverseGuitar').onclick=()=>{rfInstrument='guitar';$('reverseGuitar').classList.add('active');$('reversePiano').classList.remove('active');rfUpdate()};
$('reverseClear').onclick=()=>{if(rfInstrument==='piano')rfPiano.clear();else rfFrets.fill(0);rfUpdate()};
$('reverseListen').onclick=()=>{const notes=rfInstrument==='piano'?[...rfPiano]:rfFrets.flatMap((f,i)=>f<0?[]:[rfOpen[i]+f]);if(notes.length)playNotes(notes)};
$('reverseInstrument').addEventListener('click',e=>{const el=e.target.closest('[data-rf]');if(!el)return;const v=el.dataset.rf;if(rfInstrument==='piano'){const n=+v;rfPiano.has(n)?rfPiano.delete(n):rfPiano.add(n)}else{const [rawI,rawF]=v.split(':');const i=Number(rawI);rfFrets[i]=rawF==='x'?-1:Number(rawF)}rfUpdate()});
$('reverseInstrument').addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target.matches('[data-rf]')){e.preventDefault();e.target.dispatchEvent(new MouseEvent('click',{bubbles:true}))}});
rfUpdate();
</script><script>
