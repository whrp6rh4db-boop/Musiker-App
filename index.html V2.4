let worldSelected='Saxophon',worldPart='';
const safeWorld=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function worldList(){
 const q=$('worldSearch').value.trim().toLocaleLowerCase('de'),f=$('worldFamily').value;
 const list=worldData.filter(x=>(f==='all'||x.family===f)&&[x.name,x.family,x.kinds,x.origin].join(' ').toLocaleLowerCase('de').includes(q));
 $('worldCount').textContent=list.length+' von '+worldData.length+' Instrumenten';
 $('worldGrid').innerHTML=list.length?list.map(x=>`<button type="button" class="world-tile ${x.name===worldSelected?'selected':''}" data-world="${safeWorld(x.name)}"><span class="world-emoji">${x.emoji}</span><strong>${safeWorld(x.name)}</strong><small>${safeWorld(x.family)}</small></button>`).join(''):'<p>Keine Instrumente gefunden. Suche oder Filter ändern.</p>';
 $('worldGrid').querySelectorAll('[data-world]').forEach(b=>b.onclick=()=>{worldSelected=b.dataset.world;worldPart='';worldList();worldDetail();$('worldDetail').scrollIntoView({behavior:'smooth',block:'start'})});
}
function worldDetail(){
 const x=worldData.find(a=>a.name===worldSelected);if(!x)return;
 const partNames=Object.keys(x.parts);if(!partNames.includes(worldPart))worldPart=partNames[0];
 const checkKey='world-care-v16-'+x.name;let done=[];try{done=JSON.parse(localStorage.getItem(checkKey)||'[]')}catch{}
 $('worldDetail').innerHTML=`<div class="eyebrow">INSTRUMENTENPROFIL · ${safeWorld(x.family)}</div><h2>${x.emoji} ${safeWorld(x.name)}</h2><div class="world-facts"><div class="fact"><h3>📜 Geschichte & Herkunft</h3><p>${safeWorld(x.origin)}</p></div><div class="fact"><h3>🎼 Arten & Bauformen</h3><p>${safeWorld(x.kinds)}</p></div><div class="fact"><h3>🔊 Klang & Einsatz</h3><p>${safeWorld(x.sound)}</p></div><div class="fact"><h3>💡 Wusstest du?</h3><p>${safeWorld(x.fact)}</p></div></div><h3>🔍 Aufbau entdecken</h3><p>Tippe ein Bauteil an, um seine Funktion zu erfahren.</p><div class="part-buttons">${partNames.map(p=>`<button type="button" data-part="${safeWorld(p)}" class="${p===worldPart?'active':''}">${safeWorld(p)}</button>`).join('')}</div><div id="partDescription" class="part-description"><strong>${safeWorld(worldPart)}</strong><p>${safeWorld(x.parts[worldPart])}</p></div><h3>🧼 Pflege-Checkliste</h3><p class="muted">Deine Häkchen werden nur auf diesem Gerät gespeichert.</p><div class="world-care">${x.care.map((t,i)=>`<label><input type="checkbox" data-care="${i}" ${done.includes(i)?'checked':''}><span>${safeWorld(t)}</span></label>`).join('')}</div><h3>🎯 Spieltipp</h3><div class="world-tip">${safeWorld(x.tip)}</div>${x.link?`<div class="row"><button class="action primary" id="worldJump">${x.link==='sax'?'🎷 Zur Saxophon-Griffansicht':'🎹 Zu Akkorden & Griffen'} →</button></div>`:''}<p class="world-meta">Einführende Übersicht. Instrumentenmodelle und Pflegehinweise können abweichen; Herstellerangaben beachten.</p>`;
 $('worldDetail').querySelectorAll('[data-part]').forEach(b=>b.onclick=()=>{worldPart=b.dataset.part;worldDetail()});
 $('worldDetail').querySelectorAll('[data-care]').forEach(b=>b.onchange=()=>{let v=[...$('worldDetail').querySelectorAll('[data-care]:checked')].map(a=>+a.dataset.care);try{localStorage.setItem(checkKey,JSON.stringify(v))}catch{}});
 if(x.link)$('worldJump').onclick=()=>{document.querySelector(`[data-tab="${x.link}"]`).click();document.getElementById(x.link).scrollIntoView({behavior:'smooth'})};
}
$('worldSearch').addEventListener('input',worldList);$('worldFamily').addEventListener('change',worldList);worldList();worldDetail();

