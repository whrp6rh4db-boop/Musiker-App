.studio-hero{margin:8px 0 25px}.studio-hero h1{font-size:clamp(36px,8vw,64px)}
.studio-intro{display:flex;justify-content:space-between;gap:8px;color:#a6c2d7;font-size:11px;font-weight:800;letter-spacing:1.5px;margin-bottom:14px}
.studio-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.studio-tile{position:relative;min-width:0;display:flex;flex-direction:column;overflow:hidden;border:1px solid #3c5470;border-radius:20px;background:#14243a;color:white;text-align:left;padding:0;min-height:200px;box-shadow:0 12px 28px #0003;transition:transform .15s,border-color .15s}
.studio-tile:active{transform:scale(.975)}.studio-tile:focus-visible{outline:3px solid #50dfce;outline-offset:3px}
.studio-art{position:relative;display:grid;place-items:center;height:137px;overflow:hidden;background:radial-gradient(circle at 62% 30%,#4c80a9 0%,#173653 35%,#07172a 100%)}
.studio-art:before{content:'';position:absolute;width:175px;height:175px;border:1px solid #ffffff28;border-radius:50%;transform:rotate(-25deg) scaleX(1.5)}
.studio-art:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#101d31 0%,transparent 52%)}
.studio-art-symbol{font-size:75px;line-height:1;z-index:1;filter:drop-shadow(0 8px 14px #0008)}
.studio-art-lines{position:absolute;right:8px;top:4px;color:#ffffff45;letter-spacing:7px;font-size:19px;transform:rotate(-18deg)}
.tile-circle .studio-art{background:radial-gradient(circle,#126c78,#102a47 60%,#091728)}.tile-circle .studio-art-symbol{font-size:88px;color:#5ce7d4;text-shadow:0 0 22px #4fe4d5}
.tile-guitar .studio-art{background:radial-gradient(circle at 65% 20%,#88552d,#312b42 55%,#0a172a)}
.tile-sax .studio-art{background:radial-gradient(circle at 65% 20%,#ae7334,#46332e 48%,#091728)}
.tile-world .studio-art{background:radial-gradient(circle,#476c7d,#172e49 65%,#08172a)}
.tile-songs .studio-art{background:radial-gradient(circle,#76599e,#252a55 65%,#08172a)}
.tile-practice .studio-art{background:radial-gradient(circle,#a46c56,#41314a 65%,#08172a)}
.tile-tuner .studio-art{background:radial-gradient(circle,#347b7c,#1a3a4d 65%,#08172a)}
.tile-live .studio-art{background:radial-gradient(circle,#7e4c93,#31274b 65%,#08172a)}
.studio-tile-text{display:flex;flex-direction:column;gap:3px;padding:10px 27px 13px 13px}.studio-tile-text strong{font-size:16px}.studio-tile-text small{font-size:11px;color:#aabdd0;line-height:1.3}.studio-arrow{position:absolute;right:12px;bottom:14px;color:#55e4d4;font-size:20px}
.studio-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 18px}.studio-toolbar[hidden],.tabs[hidden]{display:none!important}
.studio-toolbar button{border:1px solid #4a637e;background:#172d46;color:#55e4d4;border-radius:14px;padding:12px 17px;font-weight:800}.studio-toolbar span{color:#bbcee0;font-size:13px;text-align:right}
@media(min-width:750px){.studio-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:420px){main{padding:18px 14px 70px}.studio-grid{gap:10px}.studio-tile{min-height:178px}.studio-art{height:116px}.studio-art-symbol{font-size:65px}.studio-tile-text strong{font-size:14px}.studio-tile-text small{font-size:10px}.studio-tile-text{padding:9px 21px 11px 10px}}
</style><style>
.help-wrap{margin:0 0 18px}.help-toggle{display:flex;align-items:center;gap:10px;justify-content:center;width:100%;padding:14px 18px;border:1px solid #55cfc8;border-radius:16px;background:#113b48;color:#eaffff;font-weight:800;font-size:16px;box-shadow:0 5px 18px #0003}.help-toggle:focus-visible{outline:3px solid #a3fff2;outline-offset:3px}.help-toggle .help-chevron{margin-left:auto}.help-content{margin-top:12px;padding:20px;background:#102038;border:1px solid #3a6173;border-radius:18px}.help-content[hidden]{display:none!important}.help-content h3{margin:0 0 8px;color:#61e8d7}.help-content .help-intro{margin:0 0 15px;color:#c8d7e8}.help-steps{list-style:none;padding:0;margin:0;display:grid;gap:13px;counter-reset:step}.help-steps li{position:relative;padding-left:44px;min-height:34px;color:#c5d4e5}.help-steps li::before{counter-increment:step;content:counter(step);position:absolute;left:0;top:1px;width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:#45d6c6;color:#082331;font-weight:900}.help-steps strong{display:block;color:#fff;margin-bottom:3px}.help-tip{margin-top:18px;padding:13px 15px;background:#193b4d;border-left:3px solid #55e2d0;border-radius:10px;color:#e1f7f5}.help-visual{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8px;margin:14px 0 18px;padding:15px 8px;border-radius:13px;background:#0b1729}.help-note,.help-beat,.help-pitch{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;min-width:52px;min-height:48px;padding:6px 9px;border:1px solid #41778b;border-radius:12px;color:#f3ffff;background:#153b50;font-weight:800;text-align:center}.help-note small{font-size:11px;color:#a8d4e5}.help-arrow,.help-plus{color:#58e2d3;font-weight:800}.help-beat{border-radius:50%;min-width:44px;min-height:44px}.help-beat.first,.help-pitch.center{background:#36c8b7;color:#062a30}.help-pitch{font-size:12px;min-width:74px}.help-example{padding:13px;background:#09172a;border:1px solid #36526b;border-radius:12px;margin:10px 0 18px;overflow-wrap:anywhere}.help-example code{color:#8ceadf;font-size:14px;line-height:1.8}@media(max-width:480px){.help-content{padding:15px}.help-pitch{min-width:65px;font-size:11px}.help-wrap{margin-bottom:13px}}

.tile-scanner .studio-art{background:radial-gradient(circle at 50% 20%,#1c8c99,#133c5b 55%,#091728)}
.sc-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.45fr);gap:16px;align-items:start}.sc-box{background:#102039;border:1px solid #39516e;border-radius:17px;padding:16px;margin-bottom:14px}.sc-box h3{margin:0 0 12px;color:#62e8d9}.sc-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.sc-fields label{font-size:12px;color:#b5cbe0;display:flex;flex-direction:column;gap:5px}.sc-fields input,.sc-fields select,.sc-box textarea,.sc-box input[type=file]{width:100%;min-width:0;padding:11px;border:1px solid #4b6680;border-radius:10px;background:#0b1a2e;color:white;font-size:15px}.sc-box textarea{min-height:112px;font-family:ui-monospace,monospace}.sc-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.sc-actions button,.sc-seg button{border:1px solid #5086a0;border-radius:11px;padding:11px 13px;background:#17334b;color:#eaffff;font-weight:700;cursor:pointer}.sc-actions button.primary,.sc-seg button.selected{background:#4bdacb;color:#072631;border-color:#4bdacb}.sc-seg{display:flex;gap:8px}.sc-seg button{flex:1}.sc-preview-wrap{background:#071424;border:1px solid #3b566c;padding:10px;border-radius:16px;overflow:auto}.sc-paper{background:white;color:#0a1627;width:100%;max-width:100%;aspect-ratio:210/297;margin:auto;padding:5%;box-shadow:0 4px 18px #0005;overflow:hidden}.sc-paper.landscape{aspect-ratio:297/210}.sc-paper h2{color:#0b1830;text-align:center;font-size:clamp(15px,2.5vw,25px);margin:0 0 4px}.sc-paper p{text-align:center;font-size:11px;color:#36465b;margin:0 0 14px}.sc-paper svg{width:100%;height:auto;display:block}.sc-import-preview{margin-top:10px;max-height:300px;overflow:auto;border:1px solid #4c637a;border-radius:10px}.sc-import-preview img{display:block;max-width:100%;height:auto;margin:auto}.sc-import-preview iframe{width:100%;height:260px;border:0;background:white}.sc-info{font-size:13px;color:#c3d3e5;line-height:1.55}.sc-warn{padding:10px 12px;background:#3b3021;border:1px solid #876b43;border-radius:10px;color:#ffdfa8;font-size:13px;margin-top:10px}.sc-status{font-size:13px;color:#80e8d9;margin-top:9px;min-height:20px}.sc-print-root{display:none}
@media(max-width:730px){.sc-layout{grid-template-columns:1fr}.sc-box{padding:12px}.sc-paper{padding:4%}.sc-fields{grid-template-columns:repeat(2,minmax(0,1fr))}}
@page{size:A4 portrait;margin:0}
@media print{body.sc-printing>*{display:none!important}body.sc-printing .sc-print-root{display:block!important;position:fixed;inset:0;background:white;color:black}body.sc-printing .sc-print-root .sc-paper{box-shadow:none!important;max-width:none!important;width:100%!important;height:100%!important;aspect-ratio:auto!important;padding:12mm!important}body.sc-printing .sc-print-root .sc-paper svg{max-height:90%;}body.sc-printing .sc-print-root.landscape{width:297mm;height:210mm}body.sc-printing .sc-print-root.portrait{width:210mm;height:297mm}}
</style></head><body><main><header><div class="brand">♫ MUSIKER<span>APP</span></div><div class="version">STUDIO · V2.4.0</div></header><section class="hero studio-hero" id="homeHero"><div class="eyebrow">DEIN MUSIKSTUDIO FÜR UNTERWEGS</div><h1>Deine Musik.<br><span class="accent">Dein Sound.</span></h1><p>Wähle einen Bereich. Alle Werkzeuge sind nur einen Tipp entfernt.</p></section><section id="homeDashboard" aria-label="Musiker App Startseite"><div class="studio-intro"><span>♫ DEIN STUDIO</span><span>9 MUSIKBEREICHE</span></div><div class="studio-grid"><button type="button" class="studio-tile tile-circle" data-open="circle" aria-label="Quintenzirkel öffnen"><span class="studio-art" aria-hidden="true"><span class="studio-art-symbol">◉</span><span class="studio-art-lines">♪ ♫ ♬</span></span><span class="studio-tile-text"><strong>Quintenzirkel</strong><small>Tonarten & Transponieren</small></span><span class="studio-arrow" aria-hidden="true">↗</span></button><button type="button" class="studio-tile tile-guitar" data-open="chords" aria-label="Akkorde öffnen"><span class="studio-art" aria-hidden="true"><span class="studio-art-symbol">🎸</span><span class="studio-art-lines">♪ ♫ ♬</span></span><span class="studio-tile-text"><strong>Akkorde</strong><small>Gitarre, Piano & Finder</small></span><span class="studio-arrow" aria-hidden="true">↗</span></button><button type="button" class="studio-tile tile-sax" data-open="sax" aria-label="Saxophon öffnen"><span class="studio-art" aria-hidden="true"><span class="studio-art-symbol">🎷</span><span class="studio-art-lines">♪ ♫ ♬</span></span><span class="studio-tile-text"><strong>Saxophon</strong><small>Griffe & Noten</small></span><span class="studio-arrow" aria-hidden="true">↗</span></button><button type="button" class="studio-tile tile-world" data-open="world" aria-label="Instrumentenwelt öffnen"><span class="studio-art" aria-hidden="true"><span class="studio-art-symbol">🎺</span><span class="studio-art-lines">♪ ♫ ♬</span></span><span class="studio-tile-text"><strong>Instrumentenwelt</strong><small>Entdecken & Lernen</small></span><span class="studio-arrow" aria-hidden="true">↗</span></button><button type="button" class="studio-tile tile-songs" data-open="songs" aria-label="Meine Songs öffnen"><span class="studio-art" aria-hidden="true"><span class="studio-art-symbol">♫</span><span class="studio-art-lines">♪ ♫ ♬</span></span><span class="studio-tile-text"><strong>Meine Songs</strong><small>Akkorde & Repertoire</small></span><span class="studio-arrow" aria-hidden="true">↗</span></button><button type="button" class="studio-tile tile-practice" data-open="practice" aria-label="Üben & Hören öffnen"><span class="studio-art" aria-hidden="true"><span class="studio-art-symbol">🥁</span><span class="studio-art-lines">♪ ♫ ♬</span></span><span class="studio-tile-text"><strong>Üben & Hören</strong><small>Metronom & Begleitung</small></span><span class="studio-arrow" aria-hidden="true">↗</span></button><button type="button" class="studio-tile tile-tuner" data-open="tuner" aria-label="Stimmgerät öffnen"><span class="studio-art" aria-hidden="true"><span class="studio-art-symbol">🎤</span><span class="studio-art-lines">♪ ♫ ♬</span></span><span class="studio-tile-text"><strong>Stimmgerät</strong><small>Den richtigen Ton treffen</small></span><span class="studio-arrow" aria-hidden="true">↗</span></button><button type="button" class="studio-tile tile-live" data-open="live" aria-label="Live-Modus öffnen"><span class="studio-art" aria-hidden="true"><span class="studio-art-symbol">🎙</span><span class="studio-art-lines">♪ ♫ ♬</span></span><span class="studio-tile-text"><strong>Live-Modus</strong><small>Bühne & Songansicht</small></span><span class="studio-arrow" aria-hidden="true">↗</span></button><button type="button" class="studio-tile tile-scanner" data-open="scanner" aria-label="Noten-Scanner öffnen"><span class="studio-art" aria-hidden="true"><span class="studio-art-symbol">🎼</span><span class="studio-art-lines">♪ ♫ ♬</span></span><span class="studio-tile-text"><strong>Noten-Scanner</strong><small>Import · Transponieren · A4-PDF</small></span><span class="studio-arrow" aria-hidden="true">↗</span></button></div></section><div class="studio-toolbar" id="studioToolbar" hidden><button type="button" id="studioBack">← Startseite</button><span id="studioCurrent"></span></div><nav class="tabs" id="tabs" hidden><button data-tab="circle">◉ Quintenzirkel</button><button data-tab="chords">🎸 Akkorde</button><button data-tab="sax">🎷 Saxophon</button><button data-tab="world">🎺 Instrumentenwelt</button><button data-tab="songs">♫ Meine Songs</button><button data-tab="practice">🥁 Üben & Hören</button><button data-tab="tuner">🎤 Stimmgerät</button><button data-tab="live">🎙 Live-Modus</button><button data-tab="scanner">🎼 Noten-Scanner</button></nav>
<section class="panel" id="circle"><div class="help-wrap"><button type="button" class="help-toggle" aria-expanded="false" aria-controls="help-circle">📖 Bedienungsanleitung <span class="help-chevron" aria-hidden="true">＋</span></button><div class="help-content" id="help-circle" hidden><h3>So nutzt du Quintenzirkel</h3><p class="help-intro">Schritt für Schritt erklärt – mit Tipps für die Praxis.</p><div class="help-visual" aria-label="Quintenzirkel: C, G, D im Uhrzeigersinn"><span class="help-note">C-Dur<br><small>0 ♯</small></span><span class="help-arrow">→</span><span class="help-note">G-Dur<br><small>1 ♯</small></span><span class="help-arrow">→</span><span class="help-note">D-Dur<br><small>2 ♯</small></span></div><ol class="help-steps"><li><strong>Tonart auswählen</strong>Tippe auf eine Tonart im äußeren Kreis. Dur und Moll kannst du über die Schaltflächen umstellen.</li><li><strong>Vorzeichen lesen</strong>Im Kreis erkennst du die Vorzeichen. Im Uhrzeigersinn kommt jeweils ein Kreuz hinzu, gegen den Uhrzeigersinn ein Be.</li><li><strong>Transponieren</strong>Wähle die Ausgangstonart und anschließend die Zieltonart im Transpositionsring. Vergleiche danach die Akkorde und Tonstufen.</li><li><strong>Mit dem Instrument üben</strong>Spiele eine kurze Akkordfolge zunächst in C-Dur und übertrage sie anschließend beispielsweise nach D-Dur.</li></ol><div class="help-tip">💡 <strong>Praxis-Tipp:</strong> Tipp: Für Saxophon zählt die geschriebene Tonart: Ein Altsaxophon in Es benötigt gegenüber Konzerttonart C eine A-Dur-Notierung; ein Tenorsaxophon in B eine D-Dur-Notierung.</div></div></div><div class="layout"><div class="card"><h2>Interaktiver Quintenzirkel mit Vorzeichen</h2><p>Wähle die Originaltonart im Dur-Ring und die Zieltonart im inneren Transpositionsring. Außen siehst du die Vorzeichen jeder Tonart.</p><div class="row"><button class="chip active" id="modeMajor">Dur</button><button class="chip" id="modeMinor">Moll</button></div><svg class="circle" id="circleSvg" viewBox="0 0 560 560" aria-label="Interaktiver Quintenzirkel"></svg></div><div class="card"><h2>Ausgewählte Tonart</h2><div class="big" id="keyName">C-Dur</div><p id="keyInfo"></p><h3>Tonleiter</h3><div class="notes" id="scale"></div><div class="transpose-panel"><h3>↗ Tonart umschreiben</h3><p class="muted">Alle 12 Halbtöne auswählbar – inklusive Cis/Des, Dis/Es, Fis/Ges, Gis/As und Ais/B.</p><div class="row"><label>Original <select id="transFrom"></select></label><label>Ziel <select id="transTo"></select></label></div><p id="transSummary"></p><div id="transMap" class="trans-map"></div><h3>Akkordfolge transponieren</h3><input id="transChords" style="width:100%" value="C G Am F" aria-label="Akkordfolge eingeben"><p id="transChordResult" class="notes"></p></div><h3>Dreiklänge der Tonart</h3><div id="diatonic" class="row"></div><button class="action primary" id="playScale">▶ Tonleiter anhören</button><p class="muted">Alle Klänge werden direkt im Browser erzeugt.</p></div></div></section>
<section class="panel" id="chords"><div class="help-wrap"><button type="button" class="help-toggle" aria-expanded="false" aria-controls="help-chords">📖 Bedienungsanleitung <span class="help-chevron" aria-hidden="true">＋</span></button><div class="help-content" id="help-chords" hidden><h3>So nutzt du Akkorde &amp; Chord-Finder</h3><p class="help-intro">Schritt für Schritt erklärt – mit Tipps für die Praxis.</p><div class="help-visual" aria-label="Beispiel Akkord C-Dur besteht aus C, E und G"><span class="help-note">C</span><span class="help-plus">+</span><span class="help-note">E</span><span class="help-plus">+</span><span class="help-note">G</span><span class="help-arrow">= C-Dur</span></div><ol class="help-steps"><li><strong>Instrument auswählen</strong>Entscheide dich für Gitarre oder Keyboard.</li><li><strong>Akkord bestimmen</strong>Wähle Grundton und Akkordtyp. Die App zeigt die passenden Töne und vorhandene Griffvarianten.</li><li><strong>Akkord anhören</strong>Nutze die Wiedergabe, um dir den Klang einzuprägen.</li><li><strong>Umgekehrt suchen</strong>Im Chord-Finder kannst du auf dem Griffbrett oder der Klaviatur Töne markieren. Die App schlägt passende Akkordnamen vor.</li></ol><div class="help-tip">💡 <strong>Praxis-Tipp:</strong> Tipp: Auf der Gitarre klingen nicht gedrückte Saiten offen mit, sofern sie nicht stummgeschaltet sind. Prüfe deshalb beim Chord-Finder immer alle sechs Saiten.</div></div></div><div class="card"><h2>Akkorde & Griffvarianten</h2><p>Instrument, Grundton und Akkordtyp wählen.</p><div class="row"><label>Instrument <select id="instrument"><option value="guitar">Gitarre</option><option value="keyboard">Keyboard</option></select></label><label>Grundton <select id="chordRoot"></select></label><label>Typ <select id="chordType"><option value="maj">Dur</option><option value="min">Moll</option><option value="7">7</option><option value="maj7">maj7</option><option value="m7">m7</option><option value="sus4">sus4</option><option value="dim">vermindert</option></select></label><button class="action primary" id="playChord">▶ Anhören</button></div><div id="chordDetails"></div><div class="reverse-finder"><h3>🎯 Akkord erkennen – direkt auf dem Instrument spielen</h3><p>Tippe auf die Klaviertasten oder auf eine Gitarrensaite im gewünschten Bund. Alle Saiten klingen zunächst leer. Tippe auf einen Bund, um ihn zu greifen. Mit dem × links kannst du einzelne Saiten stummschalten.</p><div class="row"><button type="button" class="chip active" id="reversePiano">🎹 Keyboard</button><button type="button" class="chip" id="reverseGuitar">🎸 Gitarre</button><button type="button" class="action" id="reverseClear">Auswahl löschen</button><button type="button" class="action primary" id="reverseListen">▶ Töne anhören</button></div><div id="reverseInstrument"></div><div class="reverse-result" aria-live="polite"><div class="eyebrow">ERKANNTER AKKORD</div><div class="big" id="reverseName">C</div><div id="reverseNotes" class="notes"></div><p id="reverseHint" class="muted"></p></div></div></div></section>
<section class="panel" id="sax"><div class="help-wrap"><button type="button" class="help-toggle" aria-expanded="false" aria-controls="help-sax">📖 Bedienungsanleitung <span class="help-chevron" aria-hidden="true">＋</span></button><div class="help-content" id="help-sax" hidden><h3>So nutzt du Saxophon – Griffe &amp; Noten</h3><p class="help-intro">Schritt für Schritt erklärt – mit Tipps für die Praxis.</p><ol class="help-steps"><li><strong>Saxophon auswählen</strong>Stelle Alt (Es) oder Tenor (B) ein. Die Griffbilder beziehen sich auf geschriebene Saxophontöne.</li><li><strong>Ton auswählen</strong>Nutze die Tonliste oder die Pfeiltasten. Das Griffbild passt sich an den gewählten Ton an.</li><li><strong>Markierungen verstehen</strong>Türkis zeigt gedrückte Klappen. Blau kennzeichnet die linke, Orange die rechte Hand.</li><li><strong>Noten vergleichen</strong>Sieh dir die Note im Notensystem an und spiele den Griff langsam nach.</li><li><strong>Ton hören und kontrollieren</strong>Vergleiche den Ton mit dem Hörbeispiel und überprüfe Ansatz sowie Intonation.</li></ol><div class="help-tip">💡 <strong>Praxis-Tipp:</strong> Wichtig: Die Instrumentenabbildung und einzelne Griffe sind noch nicht vollständig fachlich validiert. Für Unterricht oder Auftritte bitte mit einer verlässlichen Grifftabelle abgleichen.</div></div></div><div class="layout"><div class="card"><h2>Saxophon – Griff & Note</h2><p>Wähle Alt- oder Tenorsaxophon und einen geschriebenen Ton. Die Notenschrift zeigt die geschriebene Lage; der klingende Ton ist transponiert. Ausgewählte Grundgriffe.</p><div class="row"><label>Instrument <select id="saxType"><option value="alto">Altsaxophon (Es)</option><option value="tenor">Tenorsaxophon (B)</option></select></label><label>Geschriebener Ton <select id="saxNote"></select></label></div><div class="big" id="saxLabel"></div><p id="saxConcert"></p><div class="staff" id="saxStaff"></div><button class="action primary" id="playSax">▶ Klingenden Ton hören</button></div><div class="card"><h2>Instrument & Grifftechnik</h2><div class="sax-views" role="group" aria-label="Ansicht auswählen"></div><div id="saxFingerView"><p>Türkis = gedrückt · Gold = offen. Tippe eine Klappe an, um ihren Namen und ihre Funktion zu sehen. Die Grundgriff-Anzeige aktualisiert sich beim Tonwechsel.</p><div id="saxStudy"></div><div id="saxDiagram"></div><div class="finger-legend" aria-label="Fingerlegende"><strong>Hand- und Fingerlegende</strong><div class="finger-grid"><div><span class="finger-dot left">L</span><b>Linke Hand</b><p>Daumen: Oktavklappe<br>1 Zeigefinger · 2 Mittelfinger · 3 Ringfinger<br>4 Kleiner Finger: Gis und tiefe Klappen</p></div><div><span class="finger-dot right">R</span><b>Rechte Hand</b><p>1 Zeigefinger · 2 Mittelfinger · 3 Ringfinger<br>4 Kleiner Finger: tiefe C-/Es-Klappen</p></div></div><p><span class="finger-dot pressed"></span> Türkis = gedrückt &nbsp; <span class="finger-dot open"></span> Gold = offen</p></div><div id="saxFingerHint" class="part-description" aria-live="polite"></div><div id="saxKeyInfo" class="part-description" aria-live="polite">Tippe eine Klappe an.</div></div><p class="muted">Die Illustration zeigt sichtbare Klappenteller und wichtige Bedienelemente; die Zahl sichtbarer Klappen ist nicht gleich der Zahl unabhängig betätigter Tasten. Ausgewählte, vereinfachte Grundgriffe zur Orientierung; insbesondere tiefe, hohe und chromatische Griffe können abweichen. Nicht alle Tonhöhen und Alternativgriffe sind enthalten. Bitte Sonder- und Alternativgriffe mit einer Hersteller-Grifftabelle abgleichen.</p></div></div></section>
<section class="panel" id="world"><div class="help-wrap"><button type="button" class="help-toggle" aria-expanded="false" aria-controls="help-world">📖 Bedienungsanleitung <span class="help-chevron" aria-hidden="true">＋</span></button><div class="help-content" id="help-world" hidden><h3>So nutzt du Instrumentenwelt</h3><p class="help-intro">Schritt für Schritt erklärt – mit Tipps für die Praxis.</p><ol class="help-steps"><li><strong>Instrument finden</strong>Suche nach Namen oder filtere nach Instrumentenfamilie.</li><li><strong>Steckbrief öffnen</strong>Wähle ein Instrument, um Geschichte, Herkunft, Bauarten und Aufbau zu entdecken.</li><li><strong>Bauteile erkunden</strong>Tippe auf die angebotenen Bauteile und lies, wofür sie gebraucht werden.</li><li><strong>Pflege &amp; Spieltipps</strong>Nutze die Pflegehinweise als kleine Checkliste und probiere die Übungen aus.</li></ol><div class="help-tip">💡 <strong>Praxis-Tipp:</strong> Tipp: Vergleiche ähnliche Instrumente – etwa Alt- und Tenorsaxophon oder Akustik- und E-Gitarre. So erkennst du Unterschiede in Klang, Bauweise und Einsatz.</div></div></div><div class="card"><div class="eyebrow">ENTDECKEN · VERSTEHEN · SPIELEN</div><h2>🌍 Instrumentenwelt</h2><p>Entdecke Herkunft, Bauarten, Bauteile, Klang, Pflege und erste Spieltipps. Wähle ein Instrument und tippe anschließend seine Bauteile an.</p><div class="world-controls"><input id="worldSearch" type="search" placeholder="Instrument suchen …" aria-label="Instrument suchen"><select id="worldFamily" aria-label="Instrumentenfamilie"><option value="all">Alle Instrumentenfamilien</option><option value="Saiten">Saiteninstrumente</option><option value="Tasten">Tasteninstrumente</option><option value="Holzbläser">Holzblasinstrumente</option><option value="Blechbläser">Blechblasinstrumente</option><option value="Schlagwerk">Schlaginstrumente</option><option value="Stimme">Gesang</option></select></div><p id="worldCount" class="world-meta" aria-live="polite"></p><div id="worldGrid" class="world-grid"></div></div><div id="worldDetail" class="card world-detail" aria-live="polite"><p>Wähle oben ein Instrument aus.</p></div></section>
<section class="panel" id="songs"><div class="help-wrap"><button type="button" class="help-toggle" aria-expanded="false" aria-controls="help-songs">📖 Bedienungsanleitung <span class="help-chevron" aria-hidden="true">＋</span></button><div class="help-content" id="help-songs" hidden><h3>So nutzt du Meine Songs</h3><p class="help-intro">Schritt für Schritt erklärt – mit Tipps für die Praxis.</p><div class="help-example"><code>[G]Heute ist ein [D]guter Tag<br>[Em]Wir spielen [C]Musik</code></div><ol class="help-steps"><li><strong>Song anlegen</strong>Trage Titel, Interpret und Tonart ein.</li><li><strong>Text und Akkorde eingeben</strong>Setze Akkorde direkt vor die jeweilige Textstelle in eckige Klammern, z. B. [G]Hallo [D]Welt.</li><li><strong>Song speichern</strong>Speichere den Song. Die Daten bleiben lokal im verwendeten Browser.</li><li><strong>Für die Bühne vorbereiten</strong>Öffne den Song im Live-Modus und kontrolliere Zeilenumbrüche und Akkordpositionen.</li></ol><div class="help-tip">💡 <strong>Praxis-Tipp:</strong> Tipp: Lege zunächst zwei bis drei Probesongs an. Sichere wichtige Texte zusätzlich außerhalb der App, denn Browserdaten können beim Löschen von Websitedaten verloren gehen.</div></div></div><div class="card"><h2>Meine Songs</h2><p>Eigene Songs bleiben lokal in diesem Browser gespeichert. Für die Live-Ansicht kannst du Text und Akkorde eingeben.</p><div class="row"><input id="songTitle" placeholder="Songtitel" aria-label="Songtitel"><input id="songArtist" placeholder="Interpret" aria-label="Interpret"><label>Tonart <select id="songKey"></select></label></div><textarea id="songText" placeholder="Beispiel: [G]Heute ist ein [D]guter Tag&#10;[Em]Wir spielen [C]Musik"></textarea><div class="row"><button class="action primary" id="saveSong">Song speichern</button><button class="action" id="clearSong">Eingabe leeren</button><button class="action" id="exportSongs">Songs exportieren</button><label class="action" for="importSongs">Songs importieren</label><input type="file" id="importSongs" accept=".json,application/json" class="hidden"></div><div class="status" id="songStatus"></div><h3>Songliste</h3><div id="songList"></div></div></section>
<section class="panel" id="practice"><div class="help-wrap"><button type="button" class="help-toggle" aria-expanded="false" aria-controls="help-practice">📖 Bedienungsanleitung <span class="help-chevron" aria-hidden="true">＋</span></button><div class="help-content" id="help-practice" hidden><h3>So nutzt du Üben &amp; Hören</h3><p class="help-intro">Schritt für Schritt erklärt – mit Tipps für die Praxis.</p><div class="help-visual" aria-label="Vier Schläge pro Takt"><span class="help-beat first">1</span><span class="help-beat">2</span><span class="help-beat">3</span><span class="help-beat">4</span><span class="help-arrow">↻</span></div><ol class="help-steps"><li><strong>Tempo einstellen</strong>Starte bei einem Tempo, in dem du jeden Wechsel sauber spielen kannst, beispielsweise 60–80 BPM.</li><li><strong>Taktart wählen</strong>Stelle die Anzahl der Schläge pro Takt ein.</li><li><strong>Akkordfolge eingeben</strong>Schreibe die Akkorde mit Leerzeichen getrennt, z. B. C G Am F.</li><li><strong>Übung starten</strong>Spiele zu den Schlägen und wechsle beim angezeigten Akkord.</li><li><strong>Tempo steigern</strong>Erhöhe das Tempo erst, wenn mehrere Durchgänge fehlerfrei gelingen. Nutze die vorhandenen Hör- und Begleitfunktionen zum Mitspielen.</li></ol><div class="help-tip">💡 <strong>Praxis-Tipp:</strong> Tipp: Übe schwierige Übergänge zuerst allein, dann in einer Zweierfolge und erst anschließend im ganzen Song.</div></div></div><div class="layout"><div class="card"><h2>Interaktiver Übungsmodus</h2><p>Übe Akkordwechsel im Tempo.</p><div class="row"><label>Tempo <input id="bpm" type="number" min="40" max="220" value="90" style="width:85px"> BPM</label><label>Takte <select id="beats"><option>4</option><option>3</option></select></label></div><label>Akkordfolge (durch Leerzeichen trennen)</label><input id="progression" value="C G Am F" style="width:100%"><div class="big" id="currentPractice">C</div><div class="muted" id="beatCount">Bereit · 4/4</div><div class="row"><button class="action primary" id="startPractice">▶ Start</button><button class="action" id="stopPractice">■ Stop</button></div></div><div class="card"><h2>Begleit-Loop</h2><p>Ein einfacher elektronischer Drum-Loop als rhythmische Begleitung.</p><div class="row"><button class="action primary" id="startLoop">▶ Loop starten</button><button class="action" id="stopLoop">■ Stop</button></div><p class="muted">Audio benötigt nach dem Öffnen der Seite einen Fingertipp. Der Klang ist ein Synthesizer-/Drum-Prototyp, kein realistisches Instrumentensample.</p></div></div></section>
<section class="panel" id="tuner"><div class="help-wrap"><button type="button" class="help-toggle" aria-expanded="false" aria-controls="help-tuner">📖 Bedienungsanleitung <span class="help-chevron" aria-hidden="true">＋</span></button><div class="help-content" id="help-tuner" hidden><h3>So nutzt du Stimmgerät</h3><p class="help-intro">Schritt für Schritt erklärt – mit Tipps für die Praxis.</p><div class="help-visual" aria-label="Stimmgerät: zu tief, richtig, zu hoch"><span class="help-pitch">♭ Zu tief</span><span class="help-pitch center">✓ 0 Cent</span><span class="help-pitch">♯ Zu hoch</span></div><ol class="help-steps"><li><strong>Mikrofon freigeben</strong>Tippe auf „Mikrofon starten“ und erlaube Safari den Zugriff. Dafür ist die veröffentlichte HTTPS-Seite nötig.</li><li><strong>Einzelnen Ton spielen</strong>Spiele eine Saite oder Note möglichst sauber und ohne Nebengeräusche.</li><li><strong>Anzeige lesen</strong>Beobachte den erkannten Ton und die Abweichung in Cent. Negative Werte sind zu tief, positive zu hoch.</li><li><strong>Stimmen</strong>Verändere die Stimmung vorsichtig, bis die Abweichung möglichst nahe bei null liegt.</li><li><strong>Beenden</strong>Schalte das Mikrofon mit „Stop“ wieder aus.</li></ol><div class="help-tip">💡 <strong>Praxis-Tipp:</strong> Tipp: Stimme in ruhiger Umgebung, halte den Ton etwas länger und überprüfe danach alle Saiten oder Töne ein zweites Mal.</div></div></div><div class="card"><h2>Stimmgerät</h2><p>Nutze das Mikrofon für Gitarre oder andere Instrumente. Safari fragt nach der Mikrofonfreigabe. Nur auf HTTPS verfügbar.</p><div class="row"><button class="action primary" id="startTuner">🎤 Mikrofon starten</button><button class="action" id="stopTuner">■ Stop</button></div><div class="big" id="tunerNote">—</div><div id="tunerFreq" class="notes">Noch kein Signal</div><div id="tunerCents" class="muted">Stimme einen einzelnen, möglichst klaren Ton.</div><p class="muted">Die Tonerkennung ist experimentell; bei Akkorden und Umgebungsgeräuschen kann sie ungenau sein.</p></div></section>
<section class="panel" id="live"><div class="help-wrap"><button type="button" class="help-toggle" aria-expanded="false" aria-controls="help-live">📖 Bedienungsanleitung <span class="help-chevron" aria-hidden="true">＋</span></button><div class="help-content" id="help-live" hidden><h3>So nutzt du Live-Modus</h3><p class="help-intro">Schritt für Schritt erklärt – mit Tipps für die Praxis.</p><ol class="help-steps"><li><strong>Songs vorbereiten</strong>Lege deine Stücke zuerst unter „Meine Songs“ an.</li><li><strong>Song auswählen</strong>Wähle das Stück aus der Songliste.</li><li><strong>Lesbarkeit anpassen</strong>Vergrößere oder verkleinere die Schrift mit A+ und A−.</li><li><strong>Vollbild verwenden</strong>Nutze die Vollbildfunktion, sofern dein Browser sie unterstützt.</li><li><strong>Weiterblättern</strong>Wechsle mit den Vorheriger-/Nächster-Tasten durch deine Songs.</li></ol><div class="help-tip">💡 <strong>Praxis-Tipp:</strong> Tipp: Teste die Ansicht vor dem Auftritt bei Bühnenlicht. Aktiviere am iPhone bei Bedarf eine längere automatische Sperrzeit und sorge für ausreichend Akku.</div></div></div><div class="card"><h2>Live-Songansicht</h2><p>Große, gut lesbare Darstellung für Probe und Bühne.</p><div class="row"><label>Song <select id="liveSong"></select></label><button class="action" id="liveMinus">A−</button><button class="action" id="livePlus">A+</button><button class="action primary" id="fullScreen">⛶ Vollbild</button></div><div id="liveTitle" class="big" style="font-size:28px"></div><div id="liveContent" class="live"></div><div class="row"><button class="action" id="previousSong">← Vorheriger</button><button class="action" id="nextSong">Nächster →</button></div></div></section>

