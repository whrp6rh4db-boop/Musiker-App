let songs=[];try{songs=JSON.parse(localStorage.getItem('musikerapp-songs-v14')||'[]');if(!Array.isArray(songs))songs=[]}catch{}let editId=null;function persist(){try{localStorage.setItem('musikerapp-songs-v14',JSON.stringify(songs));$('songStatus').textContent='Auf diesem Gerät gespeichert.'}catch{$('songStatus').textContent='Speichern nicht möglich – bitte exportieren.'}}function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function clearForm(){editId=null;$('songTitle').value='';$('songArtist').value='';$('songText').value=''}$('clearSong').onclick=clearForm;$('saveSong').onclick=()=>{let title=$('songTitle').value.trim();if(!title){$('songStatus').textContent='Bitte einen Songtitel eingeben.';return}let s={id:editId||String(Date.now()),title,artist:$('songArtist').value.trim(),key:$('songKey').value,text:$('songText').value};if(editId){songs=songs.map(x=>x.id===editId?s:x)}else songs.push(s);persist();clearForm();renderSongs()};function renderSongs(){let list=$('songList');list.innerHTML=songs.length?'':'<p>Noch keine Songs gespeichert. Lege oben deinen ersten Song an.</p>';songs.forEach(s=>{let el=document.createElement('div');el.className='song';el.innerHTML=`<strong>${escapeHtml(s.title)}</strong><div class="muted">${escapeHtml(s.artist||'Ohne Interpret')} · ${escapeHtml(s.key)}</div><button class="chip" data-act="edit">Bearbeiten</button><button class="chip" data-act="open">Live öffnen</button><button class="chip" data-act="delete">Löschen</button>`;el.querySelector('[data-act=edit]').onclick=()=>{editId=s.id;$('songTitle').value=s.title;$('songArtist').value=s.artist;$('songKey').value=s.key;$('songText').value=s.text;window.scrollTo({top:0,behavior:'smooth'})};el.querySelector('[data-act=open]').onclick=()=>{setTab('live');$('liveSong').value=s.id;renderLive()};el.querySelector('[data-act=delete]').onclick=()=>{if(confirm(`„${s.title}“ wirklich löschen?`)){songs=songs.filter(x=>x.id!==s.id);persist();renderSongs()}};list.append(el)});$('liveSong').innerHTML=songs.map(s=>`<option value="${escapeHtml(s.id)}">${escapeHtml(s.title)}</option>`).join('');renderLive()}function setTab(id){document.querySelector(`[data-tab="${id}"]`).click()}$('exportSongs').onclick=()=>{const blob=new Blob([JSON.stringify(songs,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='musikerapp-songs.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};$('importSongs').onchange=async e=>{let f=e.target.files[0];if(!f)return;try{let data=JSON.parse(await f.text());if(!Array.isArray(data)||!data.every(x=>typeof x.title==='string'&&typeof x.text==='string'))throw Error();if(confirm(`${data.length} Songs importieren? Bestehende Songs bleiben erhalten.`)){songs.push(...data.map(x=>({id:String(Date.now()+Math.random()),title:x.title,artist:String(x.artist||''),key:String(x.key||'C'),text:x.text})));persist();renderSongs()}}catch{$('songStatus').textContent='Keine gültige Song-JSON-Datei.'}e.target.value=''};let liveFont=24;function renderLive(){let s=songs.find(x=>x.id===$('liveSong').value)||songs[0];$('liveTitle').textContent=s?s.title:'Noch kein Song';$('liveContent').style.fontSize=liveFont+'px';$('liveContent').innerHTML=s?escapeHtml(s.text).replace(/\[([^\]]+)\]/g,'<span class="ch">$1</span>'):'Erstelle unter „Meine Songs“ einen Song, um ihn hier anzuzeigen.';if(s)$('liveSong').value=s.id}$('liveSong').onchange=renderLive;$('livePlus').onclick=()=>{liveFont=Math.min(48,liveFont+2);renderLive()};$('liveMinus').onclick=()=>{liveFont=Math.max(16,liveFont-2);renderLive()};function moveSong(d){if(!songs.length)return;let i=songs.findIndex(s=>s.id===$('liveSong').value);$('liveSong').value=songs[(i+d+songs.length)%songs.length].id;renderLive()}$('previousSong').onclick=()=>moveSong(-1);$('nextSong').onclick=()=>moveSong(1);$('fullScreen').onclick=()=>{let el=$('live');if(el.requestFullscreen)el.requestFullscreen().catch(()=>{$('songStatus').textContent='Vollbild wird von diesem Browser nicht unterstützt.'});else alert('Auf diesem iPhone ist Vollbild für Webseiten möglicherweise nicht verfügbar. Safari kann die Ansicht trotzdem anzeigen.')};renderSongs();
// Practice / loop
let timer=null,beat=0,loop=false;function clickSound(accent){const a=ctx(),o=a.createOscillator(),g=a.createGain(),t=a.currentTime;o.frequency.setValueAtTime(accent?1000:600,t);o.type='square';g.gain.setValueAtTime(.09,t);g.gain.exponentialRampToValueAtTime(.001,t+.055);o.connect(g).connect(a.destination);o.start(t);o.stop(t+.06)}function stopBeat(){if(timer)clearInterval(timer);timer=null;beat=0;$('beatCount').textContent='Gestoppt'}function startBeat(isLoop){stopBeat();loop=isLoop;let bpm=Math.max(40,Math.min(220,+$('bpm').value||90)),beats=+$('beats').value,prog=$('progression').value.trim().split(/\s+/).filter(Boolean);if(!prog.length)prog=['C'];function tick(){let idx=Math.floor(beat/beats)%prog.length,acc=beat%beats===0;clickSound(acc);if(!loop){$('currentPractice').textContent=prog[idx];$('beatCount').textContent=`Schlag ${beat%beats+1}/${beats} · Akkord ${idx+1}/${prog.length}`;if(acc){let m=prog[idx].match(/^([A-GH](?:is|s)?)(m|7)?$/i);if(m){let r=chrom.indexOf(m[1][0].toUpperCase()+m[1].slice(1).toLowerCase());if(r>=0)playNotes((m[2]==='m'?[0,3,7]:[0,4,7]).map(x=>48+r+x))}}}beat++}tick();timer=setInterval(tick,60000/bpm)}$('startPractice').onclick=()=>startBeat(false);$('startLoop').onclick=()=>startBeat(true);$('stopPractice').onclick=stopBeat;$('stopLoop').onclick=stopBeat;document.addEventListener('visibilitychange',()=>{if(document.hidden)stopBeat()});
// Tuner: time-domain autocorrelation, deliberately basic
let stream=null,analyser=null,raf=null;function detectPitch(buffer,sr){let rms=Math.sqrt(buffer.reduce((a,b)=>a+b*b,0)/buffer.length);if(rms<.012)return null;let best=0,offset=0,low=Math.floor(sr/1000),high=Math.min(Math.floor(sr/70),buffer.length/2);for(let lag=low;lag<high;lag++){let sum=0,n=buffer.length-lag;for(let j=0;j<n;j++)sum+=buffer[j]*buffer[j+lag];let corr=sum/n;if(corr>best){best=corr;offset=lag}}if(!offset)return null;return sr/offset}function readTuner(){if(!analyser)return;let b=new Float32Array(analyser.fftSize);analyser.getFloatTimeDomainData(b);let f=detectPitch(b,ctx().sampleRate);if(f){let n=69+12*Math.log2(f/440),nearest=Math.round(n),cents=Math.round((n-nearest)*100);$('tunerNote').textContent=midiName(nearest)+Math.floor(nearest/12-1);$('tunerFreq').textContent=f.toFixed(1)+' Hz';$('tunerCents').textContent=`${cents>0?'+':''}${cents} Cent · ${Math.abs(cents)<8?'✓ Gut gestimmt':cents<0?'Etwas zu tief':'Etwas zu hoch'}`}raf=requestAnimationFrame(readTuner)}$('startTuner').onclick=async()=>{try{if(!navigator.mediaDevices?.getUserMedia)throw Error('Mikrofonzugriff nicht verfügbar');await stopTuner();stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false}});analyser=ctx().createAnalyser();analyser.fftSize=2048;let source=ctx().createMediaStreamSource(stream);source.connect(analyser);$('tunerFreq').textContent='Mikrofon aktiv – spiele einen Ton';readTuner()}catch(e){$('tunerFreq').textContent='Mikrofon nicht verfügbar oder nicht freigegeben: '+e.message}};async function stopTuner(){if(raf)cancelAnimationFrame(raf);raf=null;analyser=null;if(stream)stream.getTracks().forEach(t=>t.stop());stream=null;$('tunerNote').textContent='—'}$('stopTuner').onclick=()=>{stopTuner();$('tunerFreq').textContent='Gestoppt'};

